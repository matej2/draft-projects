FROM python:3.13
WORKDIR /app
COPY . /app
RUN pip install --no-cache-dir -r requirements.txt -v

# Ensure the `src` directory is on PYTHONPATH so imports like
# `from config.database import ...` (where `config` lives under `src/`) work.
ENV PYTHONPATH=/app/src

# Run uvicorn with app-dir set to `src` and import the app as `main:app`.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000", "--app-dir", "src"]
